NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TOUR_API_KEY=
TOUR_API_CACHE_TTL_SECONDS=1800
TOUR_API_REQUEST_TIMEOUT_MS=8000
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=
KAKAO_MAP_JS_ALLOWED_ORIGINS=http://localhost:3000
KAKAO_MAP_REQUEST_TIMEOUT_MS=4500
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TTS_MODEL=tts-1
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_REQUEST_TIMEOUT_MS=4500
# Shared default for provider probes and calls without a more specific timeout.
PROVIDER_REQUEST_TIMEOUT_MS=3000
# Server-only secret, at least 32 characters. Used by admin shorts and stamp APIs.
ADMIN_API_SECRET=
# Optional comma-separated Supabase account emails that may open /admin pages.
ADMIN_EMAILS=
# Server-only bearer secret for /api/cron/cleanup. Generate at least 32 random characters.
CRON_SECRET=
FEATURE_AI=true
FEATURE_COMMUNITY=true
STAMP_RADIUS_M=150
STAMP_MAX_ACCURACY_M=100
STAMP_VERIFY_RATE_LIMIT_PER_MINUTE=12
STAMP_REQUIRE_CHECKPOINT=false
# Optional authoritative TourAPI content IDs for the launch stamp catalogue.
# When empty, sync:tour activates seven documented flagship sights.
STAMP_TARGET_CONTENT_IDS=
STAMP_ART_GENERATION_LIMIT_PER_HOUR=4
STAMP_ART_COOLDOWN_SECONDS=86400
# Optional server-only contest demo account. Never use NEXT_PUBLIC_ for credentials.
DEMO_MODE_ENABLED=false
DEMO_EMAIL=
DEMO_PASSWORD=
# Required production operator/legal metadata. /api/health reports not-ready when omitted.
PUBLIC_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
LOCATION_TERMS_EFFECTIVE_DATE=
